{
  "schema_version": 1,
  "quilt_loader": {
    "group": "com.finndog",
    "id": "${mod_id}",
    "version": "${version}",
    "metadata": {
      "name": "${mod_name}",
      "description": "${mod_description}",
      "contributors": {
        "FinnDog": "Owner"
      },
      "contact": {
        "homepage": "${mod_homepage}",
        "sources": "${mod_sources}",
        "issues": "${mod_issues}"
      },
      "icon": "icon.png",
      "license": "LGPL-3.0-only"
    },
    "intermediate_mappings": "net.fabricmc:intermediary",
    "depends": [
      {
        "id": "quilt_resource_loader",
        "versions": "*",
        "unless": "fabric-resource-loader-v0"
      },
      {
        "id": "moogs_structures",
        "versions": "*"
      }
    ]
  }
}